# Playwright smoke용 로컬 계정 (복사: .env.e2e.local — gitignore 됨)
# scripts/run-smoke.ps1 이 있으면 자동 로드
E2E_USER_ID=admin
E2E_PASSWORD=admin123
E2E_DBA_USER_ID=dba01
E2E_DBA_PASSWORD=dba01
PLAYWRIGHT_BASE_URL=http://localhost:5173
# admin 로그인 실패 시: backend .env 에 ALLOW_INIT_ADMIN=true, INIT_ADMIN_SECRET=아무값
# 아래와 동일하게 맞추면 smoke 전에 POST /api/admin/init-e2e-passwords 로 admin·dba01 동기화
# E2E_INIT_SECRET=아무값
