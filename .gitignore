# OS / Editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# 로그
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 환경변수 (시크릿) — 절대 커밋 금지
.env
.env.local
.env.*.local
.env.production
.env.development

# 도구 부산물
.history/
.playwright-mcp/
.claude/

# 서버 셋업 참고 자료 — deploy/server-setup/ 는 레포 레퍼런스로 추적, 그 외 deploy/ 산출물은 제외
# 루트 anchor — scripts/deploy/ 같은 하위 폴더는 매칭하지 않게
/deploy/*

# 빌드 산출물 (각 서브패키지에서도 막지만 안전망)
**/node_modules/
**/dist/
**/build/
# TypeScript 증분 빌드 캐시
*.tsbuildinfo

# CodeDeploy / CI 빌드 산출 zip
*.zip
!docs/**/*.zip
