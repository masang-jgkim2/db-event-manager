PORT=4000
# 앱 메타 저장소: json(기본)=backend/data/*.json | mysql=정규화 메타 테이블(+기동 시 JSON→DB 옵션)
# DATA_STORE=mysql
# 방식 A — URL에 user:password 필수 (호스트만 넣으면 Access denied ''@클라이언트IP)
# DATA_MYSQL_URL=mysql://dqpm:비밀번호@10.31.104.28:3306/dqpm
# 방식 B — 분리 변수 (QA/LIVE CI 변수 권장). URL과 동시에 쓸 때 URL에 user 없으면 B가 보완됨
# DATA_MYSQL_HOST=10.31.104.28
# DATA_MYSQL_PORT=3306
# DATA_MYSQL_USER=dqpm
# DATA_MYSQL_PASSWORD=비밀번호
# DATA_MYSQL_DATABASE=dqpm
# 빈 DB일 때 data/*.json 자동 적재 끄기: DATA_MYSQL_NO_JSON_IMPORT=1
# 기동 시 JSON 미러↔MySQL 불일치 병합 끄기: DATA_MYSQL_SKIP_JSON_RECONCILE=1
# dbConnections.json·MySQL db_connection 비밀번호 선택 암호화(AES-256-GCM, 접두 enc:v1:). 16자 미만·미설정이면 평문 유지
# 설정 시 디스크에 평문 strPassword 가 있으면 서버 기동 1회 JSON을 enc:v1 로 덮어씀(Jest 제외). 저장 API·npm run encrypt-db-connections-json 동일
# DB_CONNECTION_PASSWORD_SECRET=랜덤-긴-문자열-16자이상-권장
# LAN·사설 DNS(예: db.masangsoft.com:5173)로 프론트 접속 시 SSE(:4000 직접) CORS — 쉼표 구분 호스트명
# DQPM_CORS_ORIGINS=db.masangsoft.com,masangsoft.com
# 내부망 전용 전체 허용: DQPM_RELAX_CORS=true (운영 공개망에서는 켜지 말 것)
# DQPM_RELAX_CORS=true
JWT_SECRET=event-manager-secret-key-change-in-production
JWT_EXPIRES_IN=24h
# 사용자 목록 «연결» 녹색: 마지막 인증 API 이후 이 시간(ms) 이내면 온라인(기본 30000). 최소 30000·최대 3600000
# USER_ONLINE_WINDOW_MS=30000
# MSSQL: 구버전/비암호화 TDS만 쓰는 서버에서 연결 실패 시 false (기본: 암호화 사용)
# MSSQL_ENCRYPT=false
# 데이터 폴더 (미설정 시 process.cwd()/data). 백엔드 한 곳만 실행 시 한 세트만 유지
# DATA_DIR=data
# 활동 로그: 1 / true / on / yes 만 기록(미설정·0 = 비기록). 개발에서 쓰려면 아래 주석 해제
# ACTIVITY_LOG_ENABLED=1
# 활동 로그 JSON 배치 저장(기본 2000ms 디바운스, 200건마다 즉시 저장). 비정상 종료 시 마지막 flush 이후 유실 가능
# ACTIVITY_LOG_FLUSH_MS=2000
# ACTIVITY_LOG_FLUSH_EVERY=200
# ACTIVITY_LOG_MAX_ROWS=10000
# Web Push(VAPID) — 미설정 시 구독 API는 503, 공개키 API는 bEnabled=false
# npx web-push generate-vapid-keys 로 키 생성
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:dqpm@example.com
# Playwright smoke — 로컬·CI에서 POST /api/admin/init-e2e-passwords (완료 후 해제 권장)
# ALLOW_INIT_ADMIN=true
# E2E 시드 후 인메모리 재로드: POST /api/e2e/reload-instances (X-E2E-Reload-Key, 비운영만)
# E2E_ALLOW_RELOAD=1
# E2E_RELOAD_KEY=local-e2e
# INIT_ADMIN_SECRET=로컬-전용-시크릿
